generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Users, roles, permissions
// ------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  /// Owner accounts cannot be deleted/demoted below the last remaining Owner (enforced in code).
  isOwner      Boolean  @default(false)
  isDisabled   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// AES-256-GCM ciphertext (base64) of the TOTP secret, keyed from SESSION_SECRET — see lib/totpCrypto.ts. Set as soon as setup begins, before totpEnabled flips true.
  totpSecretEncrypted String?
  /// False while a secret has been provisioned but not yet confirmed with a valid code — see AuthService.enableTotp.
  totpEnabled          Boolean @default(false)

  roles              UserRole[]
  serverAccess       ServerAccess[]
  sessions           Session[]
  auditLogs          AuditLog[]
  backups            Backup[]
  recoveryCodes      RecoveryCode[]
  playerBansCreated  PlayerBan[]    @relation("PlayerBanCreatedBy")
  playerBansRevoked  PlayerBan[]    @relation("PlayerBanRevokedBy")
  schedulerWorkflowsCreated SchedulerWorkflow[]
  pushSubscriptions         PushSubscription[]
  notificationPreferences   NotificationPreference[]

  @@index([email])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  /// HMAC-SHA256(SESSION_SECRET, code) — codes are single-use and high-entropy, so a fast keyed hash is appropriate (not a slow password hash).
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  /// System roles (Owner/Admin/Manager/Moderator/Viewer) are seeded and cannot be deleted.
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id  String @id @default(cuid())
  /// Dotted permission key, e.g. "servers.view" — see packages/shared/src/permissions.ts
  key String @unique

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model ServerAccess {
  id       String @id @default(cuid())
  userId   String
  serverId String
  /// "FULL" | "VIEW_ONLY" — see AccessLevel in packages/shared/src/types/enums.ts.
  /// Plain String because SQLite's Prisma connector has no native enum type;
  /// validity is enforced at the API boundary via Zod, not the DB schema.
  level String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, serverId])
  @@index([serverId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  /// SHA-256 hex of the raw session token; the raw token only ever lives in the client's cookie.
  tokenHash String   @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ------------------------------------------------------------------
// Servers
// ------------------------------------------------------------------

model Server {
  id          String @id @default(cuid())
  name        String
  description String?

  /// ServerSoftware union (VANILLA/PAPER/FABRIC/FORGE/NEOFORGE) — see the
  /// note on ServerAccess.level for why this is String, not a DB enum.
  software  String
  mcVersion String
  /// Software-specific build/loader/installer version (e.g. Paper build, Fabric loader, Forge/NeoForge version). Null for Vanilla (LEGACY) or unresolved (PANEL_MANAGED).
  buildVersion String?

  /// ServerRuntime union (LEGACY/PANEL_MANAGED) — see the type doc comment in
  /// packages/shared for the full rationale. Fixed at creation, never changes:
  /// existing rows stay LEGACY forever (itzg image + RCON), new rows are
  /// always PANEL_MANAGED (panel-owned install + direct console attach).
  runtime String @default("LEGACY")
  /// The exact runtime image tag (e.g. "ghcr.io/nicki41/latticore-runtime:java21") resolved at
  /// install time and reused on every recreateContainer() so a Restart never
  /// silently changes a server's JVM. Null for LEGACY, which always uses the
  /// global env.MINECRAFT_IMAGE.
  javaImageTag String?
  /// JSON blob recording exactly what was installed — {kind, downloadUrl,
  /// sha256, installerUrl, loaderVersion, resolvedAt} — so recreateContainer()
  /// reuses it instead of re-resolving "latest" on every restart, and so a
  /// stuck/failed install has a debugging trail. Null for LEGACY.
  installManifest String?

  containerId   String? @unique
  containerName String  @unique
  /// Game (Minecraft protocol) port published on the host.
  port    Int @unique

  memoryMb    Int
  cpuCores    Float
  diskLimitMb Int?

  /// ServerStatus union (CREATING/INSTALLING/STOPPED/STARTING/RUNNING/STOPPING/ERROR/DELETING).
  status       String @default("CREATING")
  /// Free-text detail shown in the UI when status is ERROR.
  statusDetail String?

  /// Path relative to DATA_PATH / HOST_DATA_PATH, e.g. "servers/<id>".
  dataDir String

  /// Gameplay settings (motd, max-players, difficulty, gamemode, whitelist,
  /// online-mode, pvp, view/simulation-distance, etc.) used to live here as
  /// DB columns mirrored into Docker env vars — removed because the itzg
  /// image re-applies env vars into server.properties on every container
  /// start, silently overwriting any edit made through Settings once the
  /// container already existed. The panel now owns server.properties
  /// directly (see ServerConfigService + configSchemas/serverProperties.ts)
  /// as the single source of truth; it's created with defaults at
  /// provisioning time and edited in place from then on.
  /// Must be explicitly set true by the user at creation time (checkbox in the
  /// creation wizard) before the container is ever created with EULA=TRUE.
  /// Defaults to false so any code path that forgets to pass it never
  /// accidentally accepts the EULA on the user's behalf.
  eulaAccepted Boolean @default(false)

  /// Keep only this many unlocked backups — the oldest are deleted after each new one (see BackupService.enforceRetention). Null keeps every backup.
  backupRetentionCount Int?

  /// Whether `port` is published on the host. False for servers behind a proxy (see ServerNetworkMember): they stay reachable from the proxy over the Docker network only, so nobody can bypass the proxy's authentication by connecting directly. The port stays reserved either way.
  exposePort Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  access           ServerAccess[]
  auditLogs        AuditLog[]
  backups          Backup[]
  pluginInstalls   PluginInstall[]
  playerProfiles   PlayerProfile[]
  playerSessions   PlayerSession[]
  playerNameHistory PlayerNameHistory[]
  playerIpHistory  PlayerIpHistory[]
  playerBans       PlayerBan[]
  schedulerWorkflows SchedulerWorkflow[]
  allocations      ServerAllocation[]
  notificationPreferences NotificationPreference[]
  notificationChannels    NotificationChannel[]
  /// As a proxy (Velocity/BungeeCord): the servers behind it.
  networkBackends         ServerNetworkMember[] @relation("NetworkProxy")
  /// As a backend: the proxy network this server belongs to, if any.
  networkMembership       ServerNetworkMember?  @relation("NetworkBackend")

  @@index([status])
}

// ------------------------------------------------------------------
// Proxy networks — a Velocity/BungeeCord server and the servers behind
// it. The panel writes the proxy's server list and the backends' proxy
// forwarding settings from these rows (see modules/network/).
// ------------------------------------------------------------------

model ServerNetworkMember {
  id              String   @id @default(cuid())
  proxyServerId   String
  /// A server belongs to at most one network.
  backendServerId String   @unique
  /// Name the proxy knows this backend by — the [servers] key in velocity.toml / the servers key in BungeeCord's config.yml (what /server <name> uses).
  name            String
  /// Join order: the proxy sends players to the lowest-priority backend first (velocity "try", BungeeCord "priorities").
  priority        Int      @default(0)
  createdAt       DateTime @default(now())

  proxy   Server @relation("NetworkProxy", fields: [proxyServerId], references: [id], onDelete: Cascade)
  backend Server @relation("NetworkBackend", fields: [backendServerId], references: [id], onDelete: Cascade)

  @@unique([proxyServerId, name])
  @@index([proxyServerId])
}

// ------------------------------------------------------------------
// Extra port allocations — published on the host in addition to
// Server.port (the fixed primary/game port). Lets a server open extra
// ports for things like Dynmap/BlueMap/voice chat/Geyser. Applied to
// the Docker container by MinecraftServerManager on next (re)start,
// same as memoryMb/cpuCores — see DockerMinecraftRuntime.createContainer.
// ------------------------------------------------------------------

model ServerAllocation {
  id        String   @id @default(cuid())
  serverId  String
  /// Globally unique across every server's Server.port AND every other ServerAllocation.port — enforced here at the DB level and re-checked at the API layer against Server.port (which lives in a different column, so no DB constraint can span both).
  port      Int      @unique
  createdAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
}

// ------------------------------------------------------------------
// Player activity — populated by PlayerActivityTracker from live
// server log output (join/leave/UUID/IP lines), independent of whether
// anyone has the Players page open. Not a source of truth for
// op/whitelist/ban status (that stays live from ops.json/whitelist.json/
// banned-players.json + RCON, see PlayerService) — this only tracks
// history that Minecraft itself doesn't persist anywhere readable.
// ------------------------------------------------------------------

model PlayerProfile {
  id            String @id @default(cuid())
  serverId      String
  usernameLower String
  username      String
  uuid          String?

  firstSeenAt          DateTime?
  lastSeenAt           DateTime?
  lastIp               String?
  totalPlaytimeSeconds Int       @default(0)
  /// Non-null while the player is currently connected — used to compute live playtime and to close the session on disconnect/reconcile.
  currentSessionStartedAt DateTime?

  updatedAt DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, usernameLower])
  @@index([serverId])
}

/// One row per join→leave, written by PlayerActivityTracker alongside its
/// PlayerProfile updates. Exists separately from PlayerProfile's running
/// totalPlaytimeSeconds because it's the only way to answer "how many
/// sessions", "average/longest session", and "playtime per day" without
/// re-deriving them from raw log lines every time.
model PlayerSession {
  id              String    @id @default(cuid())
  serverId        String
  usernameLower   String
  startedAt       DateTime
  endedAt         DateTime?
  durationSeconds Int?

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, usernameLower])
  @@index([serverId, startedAt])
}

/// A UUID reappearing under a different username than PlayerProfile already
/// has on record for it — written by PlayerActivityTracker.recordUuid.
/// Deliberately just a log of the rename event, not an identity merge: the
/// old username's PlayerProfile/PlayerSession rows are left exactly as they
/// were (see the schema-design note in the Players feature's plan/PR).
model PlayerNameHistory {
  id        String   @id @default(cuid())
  serverId  String
  uuid      String
  username  String
  changedAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, uuid])
}

/// Every *new* IP a player has connected from (only inserted when it differs
/// from the most recent entry for that player — a reconnect from the same
/// address doesn't spam a new row).
model PlayerIpHistory {
  id            String   @id @default(cuid())
  serverId      String
  usernameLower String
  ip            String
  seenAt        DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId, usernameLower])
}

/// One row per ban action (permanent name ban, temp name ban, or IP ban),
/// covering ban history and "is this currently active" (revokedAt null vs
/// set) in one place — PlayerService/PlayerBanService write here in
/// addition to the RCON command that actually enforces the ban.
model PlayerBan {
  id            String   @id @default(cuid())
  serverId      String
  usernameLower String
  username      String
  /// "NAME" | "IP" — see the note on ServerAccess.level for why this is a plain String.
  type          String
  /// The username (NAME) or IP address (IP) actually passed to the RCON ban command.
  target        String
  reason        String?
  createdById   String?
  createdAt     DateTime  @default(now())
  /// Non-null for a tempban — PlayerActivityTracker's periodic reconcile auto-pardons and revokes once this passes.
  expiresAt     DateTime?
  revokedAt     DateTime?
  /// Null when revokedAt was set automatically by the tempban-expiry check rather than an admin action.
  revokedById   String?
  revokedReason String?

  server    Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("PlayerBanCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  revokedBy User?  @relation("PlayerBanRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([serverId, usernameLower])
  @@index([expiresAt])
}

// ------------------------------------------------------------------
// Installed plugins/mods — optional Modrinth metadata linked to a file
// physically present in the server's plugins/mods directory.
// ------------------------------------------------------------------

model PluginInstall {
  id       String @id @default(cuid())
  serverId String

  /// The canonical "loaded" filename (e.g. "luckperms.jar"), fixed at install
  /// time and never changed by pause/resume — see modrinth.service.ts
  /// listInstalled(). Pausing renames the file on disk to
  /// "<activeFilename>.disabled" without ever touching this row, so the join
  /// between disk state and this metadata survives renames without a
  /// coordinated (and racy) two-system update.
  activeFilename String

  modrinthProjectId String
  modrinthVersionId String
  versionNumber     String?
  title             String
  /// Modrinth's project resource has no direct author field (only its
  /// search index does) — passed through from the client's already-fetched
  /// search result at install time rather than an extra API round-trip.
  /// Purely cosmetic display text, never used for any authorization/logic.
  author            String?
  iconUrl           String?
  slug              String

  installedAt DateTime @default(now())

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, activeFilename])
  @@index([serverId])
}

model Backup {
  id        String   @id @default(cuid())
  serverId  String
  fileName  String
  sizeBytes BigInt
  note      String?
  /// Locked backups are skipped by retention and can't be deleted until unlocked.
  locked    Boolean  @default(false)
  createdById String?
  createdAt DateTime @default(now())

  server    Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([serverId])
}

// ------------------------------------------------------------------
// Scheduler — user-defined workflows (ordered action steps, each with an
// optional delay before the next) that fire on a cron schedule. See
// SchedulerService for execution; Server.autoRestartEnabled/restartCron
// used to be a stub for this and were removed in favor of it.
// ------------------------------------------------------------------

model SchedulerWorkflow {
  id          String   @id @default(cuid())
  serverId    String
  name        String
  /// Standard 5-field cron expression (minute hour day month weekday), evaluated in server-local time.
  cronExpr    String
  enabled     Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  lastRunAt   DateTime?
  nextRunAt   DateTime?

  server    Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  steps     SchedulerStep[]
  runs      SchedulerRun[]

  @@index([serverId])
}

model SchedulerStep {
  id            String @id @default(cuid())
  workflowId    String
  order         Int
  /// SchedulerStepType union (COMMAND/START/STOP/RESTART/BACKUP) — see packages/shared.
  type          String
  /// Command text for COMMAND steps, optional note for BACKUP steps; null otherwise.
  payload       String?
  /// Seconds to wait AFTER this step completes before running the next one.
  delayAfterSec Int    @default(0)

  workflow SchedulerWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@unique([workflowId, order])
}

model SchedulerRun {
  id         String    @id @default(cuid())
  workflowId String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// SchedulerRunStatus union (RUNNING/SUCCESS/FAILED) — see packages/shared.
  status     String
  /// JSON-stringified array of {stepId, type, ok, message, at} — same convention as AuditLog.details.
  log        String?

  workflow SchedulerWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

// ------------------------------------------------------------------
// Audit log
// ------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  serverId  String?
  /// Dotted action key, e.g. "server.restart", "user.create", "auth.login".
  action    String
  /// JSON-stringified details blob. SQLite's Prisma connector has no native
  /// Json type, so this is serialized/deserialized by hand in audit.service.ts.
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  server Server? @relation(fields: [serverId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([serverId])
  @@index([createdAt])
}

// ------------------------------------------------------------------
// Instance-wide key/value settings (Modrinth UA overrides, etc.)
// ------------------------------------------------------------------

model Setting {
  key String @id
  /// JSON-stringified value — see the note on AuditLog.details.
  value String
}

// ------------------------------------------------------------------
// Notifications — web push (per user, per server) and external service
// channels (per server, e.g. Discord/Telegram/Slack — see
// NotificationChannel, added in a later migration). Both share the same
// fixed category set; see packages/shared/src/notifications.ts.
// ------------------------------------------------------------------

/// One row per browser/device the user has enabled push on. A user can have
/// several (phone + desktop, etc.) — all are notified for a category they
/// have enabled on a given server.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  /// The push service URL the browser handed back from
  /// pushManager.subscribe() — unique per browser+device registration.
  endpoint  String   @unique
  /// Public key (base64url) used to encrypt push payloads, from the
  /// subscription's keys.p256dh.
  p256dh    String
  /// Auth secret (base64url), from the subscription's keys.auth.
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// One row per (user, server) — this user's own push toggles for that
/// server, settable by anyone with any access level (FULL or VIEW_ONLY) to
/// the server, not gated by servers.settings.edit like NotificationChannel
/// is. Flat boolean columns, same shape as ServerAccess/ServerAllocation
/// rather than a normalized category table, since the category set is
/// fixed (see NotificationCategory in packages/shared).
model NotificationPreference {
  id       String @id @default(cuid())
  userId   String
  serverId String

  serverStatus    Boolean @default(true)
  playerActivity  Boolean @default(false)
  crash           Boolean @default(true)
  backup          Boolean @default(false)
  performance     Boolean @default(false)
  updateAvailable Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@index([serverId])
}

/// External notification target (Discord/Telegram/Slack/generic webhook),
/// server-wide rather than per-user — see the doc comment on
/// NotificationPreference for why these are separate models. Management is
/// gated on "servers.settings.edit" (FULL access only) at the API layer;
/// GET responses never include the decrypted configEncrypted contents.
model NotificationChannel {
  id       String @id @default(cuid())
  serverId String
  /// "DISCORD" | "TELEGRAM" | "SLACK" | "WEBHOOK" — see NotificationChannelType in packages/shared/src/notifications.ts. Plain String for the same reason as ServerAccess.level.
  type     String
  /// User-given name shown in the Notifications tab (e.g. "Community Discord").
  label    String
  /// AES-256-GCM ciphertext (base64) of a type-specific JSON config object
  /// (webhook URL, or bot token + chat ID, etc.) — see lib/webhookCrypto.ts.
  /// Never returned to the frontend in plaintext.
  configEncrypted String

  serverStatus    Boolean @default(true)
  playerActivity  Boolean @default(false)
  crash           Boolean @default(true)
  backup          Boolean @default(false)
  performance     Boolean @default(false)
  updateAvailable Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
}
