########################################
# Latticore — environment config
#
# Copy this file to .env and fill in real values before running
# `docker compose up -d`. Never commit the real .env file.
########################################

# ---- Core ----
NODE_ENV=production
# Port the panel (web UI + API) listens on inside the container
PORT=3000
# Port exposed on the HOST for the panel itself
PANEL_PORT=3000
# Public origin the panel is reached at — exactly as it appears in the
# browser's address bar (scheme, host, port). Used for CORS, the live
# console's WebSocket origin check, and links in notifications. Behind a
# reverse proxy, set this to the externally visible https:// URL. Reached
# under more than one address (e.g. LAN IP and a domain)? List them all,
# comma-separated — the first one is used for links in notifications.
WEB_ORIGIN=http://localhost:3000
# Time zone the panel runs in (IANA name). Scheduler workflows run on this
# clock — "0 4 * * *" means 04:00 here — and every Minecraft server gets
# it too, so console timestamps match. Defaults to UTC if unset.
TZ=Europe/Berlin

# ---- Database ----
# None of your business to configure: the panel uses an embedded SQLite
# database stored at data/db.sqlite (inside the bind mount below), created
# and migrated automatically on first boot. No separate DB container, no
# credentials. (Local, non-Docker development still needs a DATABASE_URL —
# see README "Development Setup" — but the Docker deployment ignores any
# DATABASE_URL set here; docker-compose.yml hardcodes it to the right path.)

# ---- Sessions / Security ----
# Long random secret used to sign session tokens & CSRF tokens.
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_long_random_value
# Set to "false" ONLY if you are running the panel over plain http:// on
# your local network without TLS. Keep "true" whenever a reverse proxy
# terminates TLS in front of the panel.
COOKIE_SECURE=true
# Which proxies may tell the panel the real client IP (X-Forwarded-For) —
# used for login rate limiting and the audit log. The default trusts only
# private-network addresses (a reverse proxy on the same host, Docker
# network or LAN), so a client connecting directly can't fake its IP.
# "true" trusts everyone (only if the panel is unreachable except through
# your proxy), "false" trusts no one; a comma-separated list of IPs/CIDRs
# also works.
# TRUST_PROXY=loopback,linklocal,uniquelocal

# ---- Docker integration ----
# Path to the Docker socket inside the API container (bind-mounted from host).
DOCKER_SOCKET_PATH=/var/run/docker.sock
# Not set here on purpose: the host-side path to this project's ./data
# folder is auto-detected at runtime (the API self-inspects its own
# container's mounts over the Docker socket) — no manual path entry
# needed for a normal `docker compose up -d`. Only uncomment and set this
# if that detection doesn't work for your setup (rootless Docker, Podman,
# a renamed hostname, ...) — see docs/configuration.md.
#   Linux/macOS example: HOST_DATA_PATH=/home/youruser/latticore/data
#   Windows + Docker Desktop example: HOST_DATA_PATH=//c/Users/you/latticore/data
# HOST_DATA_PATH=
# Path inside the API container where the same data is mounted (leave as-is).
DATA_PATH=/data
# Base image used for every itzg-managed Minecraft server container. Must
# be a build of itzg/docker-minecraft-server (or a compatible fork) since
# the panel relies on its VERSION/TYPE/EULA env-var contract and
# console-attach behavior. Pulled automatically on first use.
MINECRAFT_IMAGE=itzg/minecraft-server:latest
# Registry/repo prefix for the panel-managed Java runtime images (see
# runtime-images/) — published automatically for every push, pulled
# automatically on first use. Only override this if you're running a fork
# that publishes its own images, or testing a local build.
RUNTIME_IMAGE_BASE=ghcr.io/nicki41/minecontroller-runtime
# Dedicated bridge network that all Minecraft server containers join,
# isolated from the panel's own database network.
MINECRAFT_NETWORK=minecraftpanel_mc_net

# ---- Minecraft server port allocation ----
# Range the panel picks/validates game-server ports from when creating servers.
MC_PORT_RANGE_MIN=25565
MC_PORT_RANGE_MAX=25664

# ---- Modrinth ----
MODRINTH_API_URL=https://api.modrinth.com/v2
# Modrinth asks integrators to identify themselves with a descriptive UA.
MODRINTH_USER_AGENT=latticore/0.1.0 (github.com/yourname/latticore)

# ---- Push notifications ----
# Fully optional — the panel auto-generates and persists its own VAPID
# keypair on first boot if these are left unset, so web push works out of
# the box with zero configuration. Only set these if you want to pin a
# specific keypair yourself (e.g. keeping existing subscriptions valid
# across a fresh database/instance) — generate one with:
#   npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Contact address push services (Chrome, etc.) can use if your server's
# pushes ever need to be throttled/blocked — a mailto: address or https:// URL.
# Defaults to mailto:admin@<WEB_ORIGIN's hostname> if left unset.
# VAPID_SUBJECT=mailto:you@example.com
